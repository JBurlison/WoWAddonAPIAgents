{
  "name": "wow-addon-api-agents",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "check": "node scripts/build-plugin.mjs --check && node scripts/generate-api-references.mjs --check && node scripts/validate.mjs",
    "references:prepare": "node scripts/prepare-api-sources.mjs",
    "references:build": "node scripts/generate-api-references.mjs",
    "references:check": "node scripts/generate-api-references.mjs --check",
    "references:verify-source": "node scripts/generate-api-references.mjs --verify-source",
    "test": "node --test",
    "version:bump": "node scripts/version.mjs bump",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:workflow": "node scripts/compile-workflow.mjs --check",
    "compile:workflow": "node scripts/compile-workflow.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
